import pandas as pd

def advanced_security_logic(file_path):
    df = pd.read_csv(file_path)
    df['Timestamp'] = pd.to_datetime(df['Timestamp'])
    
    triage = df.groupby('Location').agg(
        Alert_Count=('Signature', 'count'),
        First_Seen=('Timestamp', 'min'),
        Last_Seen=('Timestamp', 'max'),
        Unique_Sigs=('Signature', lambda x: list(x.unique()))
    ).reset_index()

    triage['Duration_Sec'] = (triage['Last_Seen'] - triage['First_Seen']).dt.total_seconds()

    final_scores = []
    for _, row in triage.iterrows():
        is_burst = (row['Alert_Count'] > 3 and row['Duration_Sec'] < 30)
        
        has_critical_sig = any(keyword in str(row['Unique_Sigs']) for keyword in ['Malware', 'Exploit', 'Unauthorized'])

        if is_burst and has_critical_sig:
            final_scores.append('CRITICAL (Correlated Threat)')
        elif is_burst:
            final_scores.append('HIGH (Brute Force / DDoS)')
        elif has_critical_sig:
            final_scores.append('HIGH (Targeted Attack)')
        elif row['Alert_Count'] > 10:
            final_scores.append('MEDIUM (Anomalous Activity)')
        else:
            final_scores.append('LOW')

    triage['Triage_Level'] = final_scores
    return triage

results = advanced_security_logic('data/preprocessed_alerts.csv')
results.to_csv('data/advanced_triage_report.csv', index=False)
